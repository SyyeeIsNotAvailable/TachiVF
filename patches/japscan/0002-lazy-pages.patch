+package eu.kanade.tachiyomi.extension.fr.japscan
+
+internal fun paginatedBatchDriver(interfaceName: String, startPage: Int, pageCount: Int) = $$"""
+    (async function() {
+        if (window.__japscanDriverStarted) return;
+        window.__japscanDriverStarted = true;
+        var sleep = function(ms) { return new Promise(function(resolve) { setTimeout(resolve, ms); }); };
+        var selected = document.getElementById('pages');
+        var current = $$startPage;
+        var count = $$pageCount;
+
+        async function waitForBlob(timeout) {
+            var elapsed = 0;
+            while (!window.__japscanLastBlob && elapsed < timeout) {
+                await sleep(100);
+                elapsed += 100;
+            }
+            if (!window.__japscanLastBlob) throw new Error('image introuvable pour la page ' + (current + 1));
+            var latest = window.__japscanLastBlob;
+            var stable = 0;
+            while (stable < 400) {
+                await sleep(100);
+                if (latest !== window.__japscanLastBlob) {
+                    latest = window.__japscanLastBlob;
+                    stable = 0;
+                } else {
+                    stable += 100;
+                }
+            }
+            return latest;
+        }
+
+        function selectPage(index) {
+            window.__japscanLastBlob = null;
+            selected.value = String(index);
+            selected.dispatchEvent(new Event('change', {bubbles: true}));
+        }
+
+        try {
+            if (!selected || current < 0 || count < 1 || current + count > selected.options.length) {
+                throw new Error('nombre de pages modifié ; actualisez le chapitre');
+            }
+            var first = await waitForBlob(10000);
+            // Discard pre-rendered blobs and force a fresh render of the requested first page.
+            if (selected.options.length > 1) {
+                var other = current === 0 ? 1 : 0;
+                if (Number(selected.value) !== other) {
+                    selectPage(other);
+                    await waitForBlob(8000);
+                }
+                selectPage(current);
+                first = await waitForBlob(8000);
+            }
+            for (var offset = 0; offset < count; offset++) {
+                current = $$startPage + offset;
+                var url;
+                if (offset === 0) {
+                    url = first;
+                } else {
+                    selectPage(current);
+                    url = await waitForBlob(8000);
+                }
+                try {
+                    var response = await fetch(url);
+                    var blob = await response.blob();
+                    var data = await new Promise(function(resolve, reject) {
+                        var reader = new FileReader();
+                        reader.onload = function() { resolve(reader.result); };
+                        reader.onerror = reject;
+                        reader.readAsDataURL(blob);
+                    });
+                    if (typeof data !== 'string' || data.indexOf('data:image/') !== 0) {
+                        throw new Error('image invalide pour la page ' + (current + 1));
+                    }
+                    window.$${interfaceName}_savePage.post(data);
+                } finally {
+                    URL.revokeObjectURL(url);
+                }
+            }
+            window.$${interfaceName}_passDone.post('');
+        } catch (error) {
+            window.$${interfaceName}_captureError.post('page ' + (current + 1) + ' : ' + String(error.message || error));
+        }
+    })();
+""".trimIndent()
