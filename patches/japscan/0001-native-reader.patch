+package eu.kanade.tachiyomi.extension.fr.japscan
+
+import kotlinx.serialization.json.Json
+import org.jsoup.Jsoup
+import org.jsoup.nodes.Document
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.BeforeClass
+import org.junit.Test
+import uy.kohesive.injekt.Injekt
+import uy.kohesive.injekt.api.addSingleton
+
+class JapscanReaderTest {
+
+    companion object {
+        @JvmStatic
+        @BeforeClass
+        fun setUp() {
+            Injekt.addSingleton(Json { ignoreUnknownKeys = true })
+        }
+
+        private const val CHAPTER_URL = "https://www.japscan.foo/manga/choujin-x/1/"
+        private val EXPECTED_PAGES = listOf(
+            "https://c4.japscan.foo/fixture/03.png?fixture=sanitized-token",
+            "https://c4.japscan.foo/fixture/01.png?fixture=sanitized-token",
+            "https://c4.japscan.foo/fixture/02.png?fixture=sanitized-token",
+        )
+    }
+
+    private fun fixture(name: String = "reader.html"): Document = Jsoup.parse(
+        javaClass.getResource("/japscan/$name")!!.readText(),
+        CHAPTER_URL,
+    )
+
+    @Test
+    fun decodesChunkedConfigurationAndPreservesPageOrder() {
+        assertEquals(EXPECTED_PAGES, parseReaderPages(fixture(), CHAPTER_URL))
+    }
+
+    @Test
+    fun acceptsReaderWithoutProbe() {
+        assertEquals(EXPECTED_PAGES, parseReaderPages(fixture("reader-without-probe.html"), CHAPTER_URL))
+    }
+
+    @Test
+    fun rejectsDifferentChapter() {
+        val error = assertThrows(IllegalArgumentException::class.java) {
+            parseReaderPages(fixture(), "https://www.japscan.foo/manga/choujin-x/2/")
+        }
+        assertTrue(error.message.orEmpty().contains("ne correspondent pas"))
+    }
+
+    @Test
+    fun rejectsMissingConfigurationEvenWhenLiteralDecoyRemains() {
+        val document = fixture()
+        document.select("script").forEach { script ->
+            script.html("window.__rc = {\"d\":\"decoy\",\"s\":0,\"ia\":\"fakeKey\",\"p\":\"wrong\",\"v\":\"decoy\"};")
+        }
+        assertThrows(IllegalStateException::class.java) { parseReaderPages(document, CHAPTER_URL) }
+    }
+
+    @Test
+    fun rejectsMissingReaderData() {
+        val document = fixture()
+        document.select("[data-payload-code]").remove()
+        assertThrows(IllegalStateException::class.java) { parseReaderPages(document, CHAPTER_URL) }
+    }
+
+    @Test
+    fun rejectsMalformedPayload() {
+        val document = fixture()
+        document.select("[data-payload-code]").attr("data-payload-code", "prefix-???")
+        assertThrows(IllegalStateException::class.java) { parseReaderPages(document, CHAPTER_URL) }
+    }
+}
