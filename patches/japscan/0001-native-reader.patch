+package eu.kanade.tachiyomi.extension.fr.japscan
+
+import keiyoushi.utils.parseAs
+import kotlinx.serialization.SerialName
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import okio.ByteString.Companion.decodeBase64
+import org.jsoup.nodes.Document
+
+internal fun parseReaderPages(document: Document, chapterUrl: String): List<String> {
+    // The literal __rc object is a decoy; the real configuration is split into Base64 chunks.
+    val (config, element) = document.select("script:not([src])")
+        .asSequence()
+        .flatMap { CONFIG_CHUNKS.findAll(it.data()) }
+        .mapNotNull { match ->
+            runCatching {
+                match.value.parseAs<List<String>>()
+                    .joinToString("")
+                    .decodeReaderBase64()
+                    .parseAs<ReaderConfig>()
+            }.getOrNull()
+        }
+        .mapNotNull { config ->
+            document.getElementsByAttribute(config.dataKey.toDataAttribute())
+                .firstOrNull()?.let { config to it }
+        }
+        .firstOrNull()
+        ?: error("Configuration du lecteur Japscan introuvable. Le site a peut-être changé.")
+
+    val encoded = element.attr(config.dataKey.toDataAttribute()).drop(config.prefixLength)
+    val decoded = buildString(encoded.length) {
+        encoded.forEach { character ->
+            val index = SUBSTITUTION_INPUT.indexOf(character)
+            append(if (index >= 0) SUBSTITUTION_OUTPUT[index] else character)
+        }
+    }.decodeReaderBase64().parseAs<JsonObject>()
+    val chapter = decoded.parseAs<ReaderChapter>()
+    val requested = chapterUrl.toHttpUrl()
+    val decodedPath = requested.newBuilder()
+        .encodedPath("/${chapter.path.joinToString("/")}/")
+        .build().encodedPath.trimEnd('/')
+    require(decodedPath == requested.encodedPath.trimEnd('/')) {
+        "Les données du lecteur ne correspondent pas au chapitre demandé."
+    }
+
+    val imageKey = element.attr(config.imageKey.toDataAttribute()).decodeReaderBase64()
+    val images = decoded[imageKey]?.parseAs<List<String>>()?.toMutableList()
+        ?: error("Liste des pages Japscan introuvable.")
+    chapter.probeIndex?.content?.toIntOrNull()?.takeIf { it in images.indices }?.let(images::removeAt)
+    require(images.isNotEmpty()) { "Le lecteur Japscan ne contient aucune page." }
+
+    return images.map { image ->
+        val absolute = if (image.startsWith('/')) "https://c4.japscan.foo$image" else image
+        val url = absolute.toHttpUrlOrNull()?.newBuilder()
+            ?.addQueryParameter(config.parameter, config.token)?.build()
+        require(url?.scheme == "https") { "Adresse d'image Japscan invalide." }
+        url.toString()
+    }
+}
+
+private fun String.decodeReaderBase64(): String = decodeBase64()?.utf8()
+    ?: error("Données du lecteur Japscan invalides.")
+
+private fun String.toDataAttribute(): String = "data-" + UPPERCASE.replace(this) {
+    "-${it.value.lowercase()}"
+}
+
+@Serializable
+private class ReaderConfig(
+    @SerialName("d") val dataKey: String,
+    @SerialName("s") val prefixLength: Int,
+    @SerialName("ia") val imageKey: String,
+    @SerialName("p") val parameter: String,
+    @SerialName("v") val token: String,
+)
+
+@Serializable
+private class ReaderChapter(
+    @SerialName("e1046") val path: List<String>,
+    @SerialName("p77c") val probeIndex: JsonPrimitive? = null,
+)
+
+private val CONFIG_CHUNKS = Regex("""\[\s*"[A-Za-z0-9+/=]+"\s*(?:,\s*"[A-Za-z0-9+/=]+"\s*)*]""")
+private val UPPERCASE = Regex("[A-Z]")
+private val SUBSTITUTION_INPUT = "0Myg3jxF2nh4Qz7Le5WcvUYDiBXro9qOptAE61fd8CGmKkITHuVSZasRlPNJwb".reversed()
+private val SUBSTITUTION_OUTPUT = "17T6Cpaiguz5HlwUJc20KfshvLxmEGNX4AI8QePdD3YbZRW9nVMFkryOBqSotj".reversed()
