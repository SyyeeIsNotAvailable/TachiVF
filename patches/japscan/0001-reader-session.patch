+package eu.kanade.tachiyomi.extension.fr.japscan
+
+internal const val SITE_CAPTCHA_MESSAGE =
+    "Japscan : résolvez le captcha du site dans la WebView de ce chapitre, attendez l'affichage des pages, puis revenez dans le lecteur."
+
+internal val READER_STATE_SCRIPT = """
+    (function() {
+        if (window.__captcha && window.__captcha.needed === true) return "captcha";
+        var pages = document.getElementById("pages");
+        if ((pages && pages.options.length > 0) || document.querySelector("[id^='d-img-']")) return "ready";
+        return "loading";
+    })();
+""".trimIndent()
